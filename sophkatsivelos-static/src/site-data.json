    "/digital/identity-automaton": {
      "route": "/digital/identity-automaton",
      "title": "IDENTITY",
      "content": [
        {
          "tag": "h2",
          "text": "IDENTITY"
        },
        {
          "tag": "h2",
          "text": "AUTOMATON"
        },
        {
          "tag": "h3",
          "text": "2022"
        },
        {
          "tag": "p",
          "text": "Identity Automaton is a work that explores how the physical parts of us and computers relate to identity online. The work uses motion tracking to move a rig made up of electronic components like extension cords and computer mice that is only visible when the eyes are closed. When the viewer’s eyes are open they see Instagram profiles."
        },
