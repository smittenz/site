    "/for-clients/aippy": {
      "route": "/for-clients/aippy",
      "title": "WIKIPEDIA GALAXY",
      "content": [
        {
          "tag": "h2",
          "text": "WIKIPEDIA GALAXY"
        },
        {
          "tag": "p",
          "text": "2025"
        },
        {
          "tag": "p",
          "text": "Aippy, wikipedia"
        },
        {
          "tag": "p",
          "text": "Wikipedia Galaxy is a work created for the AI creative coding platform Aippy. The work takes one Wikipedia article either randomly or from a text suggestion and from that article it selects 500 other Wikipedia pages that form the stars in a galaxy. Each star is placed based on how closely related or linked the Wikipedia page is to its neighbors, directly linked pages will be pars of “constellations” connecting them. The stars color and size is also determined based on the amount of traffic on the page and the time it was last updated."
        },
        {
          "tag": "h2",
          "text": "FOURTH EYE"
        },
        {
          "tag": "p",
          "text": "2025"
